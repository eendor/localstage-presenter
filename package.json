{
  "name": "localstage",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm run build -w packages/protocol && npm run build -w apps/web && npm run build -w apps/server",
    "start": "npm run start -w apps/server",
    "test": "npm run build -w packages/protocol && npm run build -w apps/server && npm run test -w apps/server",
    "check": "npm run build && npm test",
    "launch": "node scripts/launch.mjs",
    "clean": "rimraf apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "concurrently": "^9.0.0",
    "rimraf": "^6.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
